# Required — the iOS app gives you the token and the server UUID
HEDGIEMATE_USER_TOKEN=hm_your_token_here
SERVER_ID=
MQTT_HOST=mosquitto

# Optional
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=hedgiemate-notifier
MQTT_TLS=false
MQTT_NAMESPACE=
CAR_IDS=1
RELAY_URL=https://push.hedgiemate.com
LOG_LEVEL=info
